# Copy this file to .env and fill in ONE of the two options. Never commit .env.

# Option A (recommended): OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Models are tried in order. If one is rate limited, removed or down, the next one is used.
# Free model ids change often (several were removed in a single week in October 2026), so check
# https://openrouter.ai/models?max_price=0 now and then and update this list.
# 1. google/gemma-4-31b-it:free  - Google host, does not train on prompts, 140+ languages including Hindi
# 2. nvidia/nemotron-3-super-120b-a12b:free - longest-running free model, good fallback
# 3. openrouter/free - OpenRouter picks any free model, last safety net only
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
# Optional paid upgrade for steady school or public use (about USD 1 per 1,000 chats):
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite,google/gemma-4-31b-it:free

# Option B (not recommended for real use): Hugging Face Inference Providers.
# A free account only gets about USD 0.10 of credit per month, which is a handful of chats.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-8B

# Optional. Defaults to openrouter if OPENROUTER_API_KEY is set, otherwise huggingface if HF_TOKEN is set.
# LLM_PROVIDER=openrouter
PORT=3000
# Chat requests allowed per visitor per minute
RATE_LIMIT_PER_MIN=15
# Set to 1 when the site runs behind Render, Railway, nginx or Cloudflare, so the limit is per visitor
# and not shared by everyone behind the proxy.
# TRUST_PROXY=1

# Translation is NOT done at run time. All 12 languages are pre-built into public/data/i18n/*.json
# (see README, "Languages"). To build/refresh them once on your own computer:  npm run translate
# The build script reads the keys below (first one that is set is used, the next ones are fallbacks).
# 1. FREE, recommended: Gemini key from https://aistudio.google.com/apikey (no card, all 11 Indian languages)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# 2. Google Cloud Translation key (first 500,000 characters per month free, needs billing enabled)
GOOGLE_TRANSLATE_API_KEY=
# 3. Sarvam AI (Indian-made, all 22 languages, only Rs 100 free credit = about 50,000 characters)
SARVAM_API_KEY=
# With none of them set, the script falls back to slow Google web translate (no key, rate limited).
# Optional: model(s) used by KalaLens to look at images. Must accept images.
# OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
